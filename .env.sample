# Copy to .env.local for local development. Compose sets DATABASE_PATH itself.

# SQLite database path. Relative paths resolve from the project root.
#
# Deliberately not the container's `today.db`. On the server `make dev` and the
# container share this directory, and pointing both at one file means editing
# live config through a dev Server Action. Everything in data/ is gitignored
# apart from .gitkeep, so a second database costs nothing.
DATABASE_PATH=./data/today.dev.db

# PORT is deliberately NOT set here. Next reads this file for the running app,
# but `pnpm dev` expands `${PORT:-7000}` in the shell before Next starts, so a
# value here would be ignored. Export it instead, which you need to do whenever
# the container is up, since it already holds 7000:
#
#   PORT=7100 make dev
#
# Compose reads PORT from the shell or from `.env` (again, not this file) and
# uses it for both the published port and the port inside the container.
