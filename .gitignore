# Was the 204-line GitHub Python template, left over from the FastAPI backend.
# It cost real time during the migration: its `lib/` entry silently kept the
# whole lib/ directory out of a commit, and `git add -A` reported nothing wrong.

# Dependencies
node_modules/
.pnp
.pnp.*

# Next
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# Environment. .env.sample is committed as the reference copy.
.env
.env.local
.env*.local

# Runtime data: the SQLite database and its WAL sidecars. The directory itself
# is tracked via data/.gitkeep, so a checkout creates it owned by the user
# rather than letting Docker create it owned by root (see README).
/data/*
!/data/.gitkeep

# Editors and OS
.DS_Store
Thumbs.db
.vscode/*
!/.vscode/launch.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
