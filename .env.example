# Backend (read by `cargo run` via dotenvy)
API_HOST=127.0.0.1
API_PORT=9000
DATABASE_PATH=today.db

# Vite dev server
API_PROXY_TARGET=http://127.0.0.1:9000
DEV_PORT=5173
# Comma-separated hostnames the dev server should accept, e.g. my-server
ALLOWED_HOSTS=example

# Docker Compose (host port that nginx is published on)
WEB_PORT=8000
